# Local development: leave DATABASE_URL blank for embedded local PostgreSQL (PGlite).
# Production requires a managed PostgreSQL connection and separate migration/app roles.
DATABASE_URL=
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=http://localhost:3000
ALLOW_LOCAL_PRACTICE=true
DEMO_STARTING_BALANCE=10000
# NEVER set these flags before legal, provider and security sign-off.
ENABLE_REAL_MONEY=false
REGULATORY_APPROVAL_CONFIRMED=false
# Migration CLI only. Do not give runtime DB role permission to migrate in production.
RUN_MIGRATIONS=false

# Market data. Synthetic practice fixtures are explicitly labeled when not configured.
MARKET_DATA_PROVIDER=synthetic
# Public homepage defaults to a clearly labeled, read-only synthetic training replay.
# Enable provider redistribution ONLY after explicit market-data licensing/entitlement review.
# When true, missing/failing provider credentials return an error, never a fake live price.
ENABLE_PUBLIC_MARKET_DATA=false
OANDA_ENV=practice
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
# These define an unimplemented execution adapter boundary, NOT an enabled provider.
TRADING_PROVIDER=disabled
TRADING_API_URL=
TRADING_API_TOKEN=
# OANDA uses OANDA_API_TOKEN, not a separate MARKET_DATA_API_KEY.

# Safaricom sandbox STK push. Callback must be a public HTTPS URL.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://your-staging-domain.example/api/payments/callback
# Reserved for approved B2C implementation; payout adapter deliberately disabled.
DARAJA_SECURITY_CREDENTIAL=
DARAJA_INITIATOR_NAME=
DARAJA_B2C_SHORTCODE=
DARAJA_B2C_RESULT_URL=
DARAJA_B2C_TIMEOUT_URL=

# Server-sent events are same-origin; no browser-facing WebSocket credentials.
# On serverless hosts SSE duration limits require a persistent stream gateway.
# Email verification/password reset use Resend when configured.
RESEND_API_KEY=
EMAIL_FROM=CYPHERFX <accounts@your-verified-domain.example>

# One-time operator-only bootstrap. Remove credentials after running the command.
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_PASSWORD=
INITIAL_SUPER_ADMIN_TOTP_SECRET=
# E2E_BASE_URL=http://localhost:3000
