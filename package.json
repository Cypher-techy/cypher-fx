{
  "name": "cypherfx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "worker": "tsx scripts/worker.ts",
    "admin:bootstrap": "tsx --env-file=.env.local scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@tailwindcss/postcss": "^4.1.0",
    "@vitest/mocker": "^4.1.12",
    "bcryptjs": "^3.0.2",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "lightweight-charts": "^5.0.9",
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "otplib": "^12.0.1",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  }
}
